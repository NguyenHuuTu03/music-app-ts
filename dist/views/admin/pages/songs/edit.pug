extends ../../layouts/default.pug

block main
  .page-header
    div
      h2.inner-title Chỉnh sửa bài hát
      p.page-subtitle Điền đầy đủ thông tin bên dưới
    a.btn.btn-secondary(href= prefixAdmin + "/songs")
      i.bi.bi-arrow-left
      span Quay lại

  form(action= prefixAdmin + `/songs/edit/${song.id}?_method=PATCH` method="POST" enctype="multipart/form-data")
    .form-layout
      //- Cột trái
      .form-left
        .card
          .card-header
            span.card-title
              i.bi.bi-info-circle(style="margin-right:6px; color:var(--accent)")
              | Thông tin chung
          .card-body

            .form-group
              label.form-label(for="title") Tiêu đề
              input.form-control(
                type="text"
                id="title"
                name="title"
                placeholder="Nhập tiêu đề bài hát..."
                required
                value=song.title
              )

            .form-group
              label.form-label(for="topicId") Chủ đề
              select.form-control(id="topicId" name="topicId")
                option(value="") -- Chọn chủ đề --
                if topics && topics.length > 0
                  each topic in topics
                    option(value= topic.id selected=topic.id === song.topicId) #{topic.title}

            .form-group
              label.form-label(for="singerId") Ca sĩ
              select.form-control(id="singerId" name="singerId")
                option(value="") -- Chọn ca sĩ --
                if singers && singers.length > 0
                  each singer in singers
                    option(value= singer.id selected=singer.id == song.singerId) #{singer.fullName}

            .form-group
              label.form-label(for="lyrics")
                i.bi.bi-text-left(style="margin-right:6px; color:var(--accent)")
                | Lời bài hát
              textarea.form-control.lyrics-editor(
                id="lyrics"
                name="lyrics"
                rows="10"
                placeholder="Nhập lời bài hát..."
              ) !{song.lyrics}

            .form-group
              label.form-label(for="description") Mô tả
              textarea.form-control(
                id="description"
                name="description"
                rows="4"
                placeholder="Nhập mô tả ngắn về bài hát..."
              ) !{song.description}

      //- Cột phải
      .form-right
        .card
          .card-header
            span.card-title
              i.bi.bi-image(style="margin-right:6px; color:var(--accent)")
              | Ảnh đại diện
          .card-body
            .form-group
              .upload-area(id="upload-area")
                img#preview-img(src=song.avatar alt="Preview" )
                .upload-placeholder#upload-placeholder.d-none
                  i.bi.bi-cloud-upload
                  p Nhấn để chọn ảnh
                  span.upload-hint JPG, PNG — tối đa 5MB
              input(
                type="file"
                id="avatar"
                name="avatar"
                accept="image/*"
                style="display:none"
              )

        .card(style="margin-top:16px")
          .card-header
            span.card-title
              i.bi.bi-music-note-beamed(style="margin-right:6px; color:var(--accent)")
              | File Audio
          .card-body
            .form-group(style="margin-bottom:0")
              .upload-area.audio-upload-area(id="audio-upload-area")
                .audio-placeholder#audio-placeholder.d-none
                  i.bi.bi-file-earmark-music
                  p Nhấn để chọn file audio
                  span.upload-hint MP3, WAV, OGG — tối đa 20MB
                .audio-preview#audio-preview
                  i.bi.bi-file-earmark-music(style="font-size:24px; color:var(--accent)")
                  .audio-info
                    span#audio-name(style="font-size:13px; font-weight:500; color:var(--text)") 
                    span#audio-size(style="font-size:11px; color:var(--muted)")
                  audio#audio-player(controls src=song.audio style="width:100%; margin-top:10px")
              input(
                type="file"
                id="audio"
                name="audio"
                accept="audio/*"
                style="display:none"
              )

        .card(style="margin-top:16px")
          .card-header
            span.card-title
              i.bi.bi-toggle-on(style="margin-right:6px; color:var(--accent)")
              | Trạng thái
          .card-body
            .form-group(style="margin-bottom:0")
              .status-options
                label.status-option
                  input(type="radio" name="status" value="active" checked=song.status == "active")
                  span.status-btn.status-active
                    i.bi.bi-check-circle-fill
                    |  Hoạt động
                label.status-option
                  input(type="radio" name="status" value="inactive" checked=song.status == "inactive")
                  span.status-btn.status-inactive
                    i.bi.bi-x-circle-fill
                    |  Dừng hoạt động

    .form-actions
      button.btn.btn-primary(type="submit")
        i.bi.bi-check-lg
        span Lưu lại
      a.btn.btn-secondary(href= prefixAdmin + "/songs")
        i.bi.bi-x-lg
        span Hủy