extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-4
    .row
      .col-12
        +box-head("Chủ đề bài hát")

    .row.mt-3
      each topic in topics
        .col-lg-3.col-md-6.mb-4
          .card.topic-card.h-100
            img.card-img-top(src=topic.avatar)
            .card-body.d-flex.flex-column
              h5.card-title #{topic.title}
              p.card-text.text-muted #{topic.description}
              a.btn.btn-primary.mt-auto(href=`/songs/${topic.slug}`) Xem chi tiết

      