extends ../../layouts/default.pug

block main
  .page-header
    h2.inner-title Danh sách Topics
    a.btn.btn-primary(href= prefixAdmin + "/topics/create")
      i.bi.bi-plus-lg
      span Thêm mới

  .card
    .card-body
      table.adm-table
        thead
          tr
            th STT
            th Ảnh
            th Tên chủ đề
            th Trạng thái
            th Hoạt động
        tbody
          if topics && topics.length > 0
            each topic, index in topics
              tr
                td #{index + 1}
                td
                  if topic.avatar
                    img(src= topic.avatar, alt= topic.title, style="width:44px; height:44px; object-fit:cover; border-radius:8px; border:1px solid var(--border)")
                  else
                    .no-img
                      i.bi.bi-image
                td #{topic.title}
                td
                  if topic.status === "active"
                    button.status-btn.status-active(
                      href= prefixAdmin + "/topics/toggleStatus/" + topic.id,
                      title="Nhấn để dừng"
                    )
                      i.bi.bi-check-circle-fill
                      |  Hoạt động
                  else
                    button.status-btn.status-inactive(
                      href= prefixAdmin + "/topics/toggleStatus/" + topic.id,
                      title="Nhấn để kích hoạt"
                    )
                      i.bi.bi-x-circle-fill
                      |  Dừng hoạt động
                td.action-cell
                  a.btn.btn-sm.btn-secondary(href= prefixAdmin + "/topics/detail/" + topic.id, title="Chi tiết")
                    i.bi.bi-eye
                  a.btn.btn-sm.btn-secondary(href= prefixAdmin + "/topics/edit/" + topic.id, title="Sửa")
                    i.bi.bi-pencil
                  a.btn.btn-sm.btn-danger(href= prefixAdmin + "/topics/delete/" + topic.id, title="Xóa")
                    i.bi.bi-trash
          else
            tr
              td(colspan="5", style="text-align:center; padding:40px; color:var(--muted)")
                i.bi.bi-inbox(style="font-size:28px; display:block; margin-bottom:8px; opacity:.4")
                | Chưa có topic nào