extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .singer-detail
    .container.my-3
      .row
        .col-12
          h1.inner-title #{song.title}

          .inner-actions
            .inner-action.inner-time
              i.fa-regular.fa-clock
              |  20/10/2023
            .inner-action.inner-singer
              i.fa-solid.fa-microphone-lines
              |  #{singer.fullName}
            .inner-action.inner-topic
              i.fa-solid.fa-music
              |  #{topic.title}
            div(class= "inner-action inner-like " + (song.isLike ? "active" : "") button-like=song.id data-user=user)
              i.fa-regular.fa-thumbs-up
              span #{song.like.length} thích
            
            div(class= "inner-action inner-listen ")
              i(class="fa-solid fa-headphones")
              span #{song.listen} lượt
            div(class="inner-action inner-heart " + (song.isFavoriteSong ? "active" : "") button-favorite=song.id data-user=user)
              i.fa-regular.fa-heart
              |  Bài hát yêu thích

          .inner-play
            .inner-avatar
              img(src=song.avatar alt="Cắt đôi nỗi sầu")
            .inner-audio
              //- audio(controls)
              //-   source(src="/client/audio/cat-doi-noi-sau.mp3" type="audio/mpeg")
              div(id="aplayer" data-song=song data-singer=singer)

          .info-card.inner-description
            .info-label Mô tả
            .info-content !{song.description}

          .info-card.inner-lyrics
            .info-label Lời bài hát
            .info-content !{song.lyrics}