extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-4
    .row
      .col-12
        +box-head(pageTitle)
    
    .row
      each song in songs
        .col-6.mb-3
          .song-item
            .inner-image
              a(href=`/songs/detail/${song.slug}`)
                img(src=song.avatar)

            .inner-content
              .inner-title
                a(href=`/songs/detail/${song.slug}`)= song.title

              .inner-singer
                i.fa-solid.fa-microphone-lines
                |  #{song.infoSinger ? song.infoSinger.fullName : "Không rõ"}

              .inner-like
                i.fa-solid.fa-thumbs-up
                |  #{song.like.length > 0 ? song.like.length : 0}

              .inner-time
                i.fa-regular.fa-clock
                |  Hôm nay
              