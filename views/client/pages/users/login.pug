extends ../../layouts/default.pug

block main
  .container.my-5
    .row.justify-content-center
      .col-md-6
        .card.shadow
          .card-body
            h3.text-center.mb-4 Đăng nhập

            form(method="POST" action="/users/login")
              
              .mb-3
                label.form-label Email
                input.form-control(
                  type="email"
                  name="email"
                  placeholder="Nhập email"
                  required
                )

              .mb-3
                label.form-label Mật khẩu
                input.form-control(
                  type="password"
                  name="password"
                  placeholder="Nhập mật khẩu"
                  required
                )

              button.btn.btn-primary.w-100(type="submit") Đăng nhập

            .text-center.mt-3
              span Chưa có tài khoản?
              a(href="/users/register") Đăng ký